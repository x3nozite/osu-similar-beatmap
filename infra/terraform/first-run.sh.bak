#!/usr/bin/env bash
set -e

VAULT_NAME="osu-similarity-kv"
APP_DIR="/app"

get_secret(){
  local secret_name=$1
  local token=$(curl -s -H "Metadata: true" \
    "http://169.254.169.254/metadata/identiy/oauth2/token?api-version=2018-02-01&resource=https://vault.azure.net" \ 
    | jq -r '.access_token')

  curl -s -H "Authorization: Bearer $token" \
    "https://${VAULT_NAME}.vault.azure.net/secrets/${secret_name}?api-version=7.4" \
    | jq -r '.value'
}

mkdir -p "$APP_DIR"
cd "$APP_DIR"

git clone 
